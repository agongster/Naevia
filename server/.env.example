# Copy to .env (never commit .env). mock needs no account or internet.
NAEVIA_MODEL_MODE=mock

# Live mode: any OpenAI-compatible chat-completions provider.
# The base URL INCLUDES the version prefix; the adapter appends /chat/completions.
NAEVIA_PROVIDER_BASE_URL=https://api.openai.com/v1
NAEVIA_MODEL=your-model-id
NAEVIA_PROVIDER_API_KEY=replace-me
